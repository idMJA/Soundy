{
  "name": "soundy",
  "version": "3.7.0",
  "description": "A powerful music bot built with Seyfert and lavalink-client to play high quality music in your Discord server for free.",
  "author": {
    "name": "Kiyomi Fujiwara",
    "email": "kiyomi@mja.moe",
    "url": "https://github.com/idMJA"
  },
  "license": "AGPL-3.0",
  "homepage": "https://github.com/idMJA/Soundy",
  "repository": {
    "type": "git",
    "url": "https://github.com/idMJA/Soundy"
  },
  "bugs": {
    "url": "https://github.com/idMJA/Soundy/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "encrypt": "dotenvx encrypt",
    "build": "tsdown",
    "format": "biome check --write ./src",
    "lint": "tsc --noEmit && biome check --write ./src",
    "db:generate": "dotenvx run -- drizzle-kit generate",
    "db:migrate": "dotenvx run -- drizzle-kit migrate",
    "db:studio": "dotenvx run -- drizzle-kit studio",
    "db:push": "dotenvx run -- drizzle-kit push"
  },
  "lint-staged": {
    "*.ts": [
      "bun format"
    ]
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@mjba/lyrics": "^1.3.0",
    "@napi-rs/canvas": "^1.1.0",
    "@slipher/cooldown": "^1.0.0",
    "@top-gg/sdk": "^4.0.0",
    "@tursodatabase/database": "^0.8.3",
    "@tursodatabase/sync": "^0.8.3",
    "drizzle-orm": "^1.0.0-rc.5",
    "elysia": "^1.4.30",
    "genius-lyrics": "^4.4.7",
    "ky": "^2.2.0",
    "lavalink-client": "^2.11.0",
    "lowdb": "^7.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "seyfert": "^5.2.1",
    "yunaforseyfert": "^1.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^1.0.0-rc.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ],
  "keywords": [
    "discord",
    "bot",
    "music",
    "lavalink",
    "seyfert",
    "typescript",
    "discord-bot",
    "music-bot"
  ]
}
